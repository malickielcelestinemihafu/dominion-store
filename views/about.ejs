<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - DOMINION</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white font-sans min-h-screen flex flex-col selection:bg-white selection:text-black">

    <!-- Navigation -->
    <nav class="border-b border-zinc-800 bg-black/90 px-6 py-4 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black tracking-tighter uppercase hover:opacity-80 transition">
                DOMINION
            </a>
            <a href="/admin/login" class="text-xs text-zinc-400 hover:text-white transition font-medium">
                Admin Panel
            </a>
        </div>
    </nav>

    <!-- Main About Content -->
    <main class="max-w-5xl mx-auto px-6 py-16 flex-grow">
        <div class="space-y-12">
            
            <!-- Hero Heading -->
            <div class="border-b border-zinc-800 pb-10">
                <span class="inline-block bg-zinc-800 text-zinc-300 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full border border-zinc-700 mb-4">
                    About DOMINION
                </span>
                <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight">
                    Elevating Digital Value in Tanzania.
                </h1>
                <p class="text-zinc-400 text-lg mt-4 max-w-2xl leading-relaxed">
                    DOMINION is a premier digital marketplace engineered to connect clients across Tanzania with verified products, precision performance, and uncompromised acquisition support.
                </p>
            </div>

            <!-- Mission & Vision Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-zinc-900/50 border border-zinc-800 p-8 rounded-2xl space-y-3">
                    <h2 class="text-xl font-bold uppercase tracking-wider text-white">Our Mission</h2>
                    <p class="text-zinc-400 text-sm leading-relaxed">
                        To simplify product acquisition by delivering direct verification, transparent pricing in Tanzanian Shillings (TSh), and reliable customer service for every deal.
                    </p>
                </div>
                <div class="bg-zinc-900/50 border border-zinc-800 p-8 rounded-2xl space-y-3">
                    <h2 class="text-xl font-bold uppercase tracking-wider text-white">Our Vision</h2>
                    <p class="text-zinc-400 text-sm leading-relaxed">
                        To become Tanzania’s most trusted digital hub for tech, hardware, audio, and gadgets through direct engagement and authentic customer relationships.
                    </p>
                </div>
            </div>

            <!-- Core Operations & Info -->
            <div class="bg-zinc-900/30 border border-zinc-800 p-8 rounded-2xl space-y-6">
                <h2 class="text-2xl font-black uppercase tracking-tight">Company Details & Operations</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                    <div>
                        <strong class="text-zinc-300 block mb-1">Headquarters:</strong>
                        <p class="text-zinc-400">Dar es Salaam, Tanzania</p>
                    </div>
                    <div>
                        <strong class="text-zinc-300 block mb-1">Direct Support:</strong>
                        <a href="mailto:malickielcelestine@gmail.com" class="text-white hover:underline">
                            malickielcelestine@gmail.com
                        </a>
                    </div>
                    <div>
                        <strong class="text-zinc-300 block mb-1">Operating Hours:</strong>
                        <p class="text-zinc-400">Monday - Saturday: 8:00 AM - 8:00 PM</p>
                    </div>
                </div>
            </div>

            <!-- Back to Catalog Link -->
            <div class="pt-4">
                <a href="/" class="inline-block bg-white text-black font-extrabold text-sm px-6 py-3.5 rounded-xl hover:bg-zinc-200 transition">
                    &larr; Back to Catalog
                </a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400 text-sm pt-16 pb-10">
        <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row justify-between items-start gap-12 mb-12">
            <div class="lg:w-1/3">
                <h2 class="text-5xl md:text-6xl font-black text-white tracking-tighter uppercase leading-none">
                    DOMINION
                </h2>
            </div>
            <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-3 gap-8 w-full">
                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">PAGES</h3>
                    <ul class="space-y-2 text-zinc-400 text-xs font-medium">
                        <li><a href="/about" class="text-white font-bold transition">About Us</a></li>
                        <li><a href="/#catalog" class="hover:text-white transition">Featured Products</a></li>
                        <li><a href="/admin/login" class="hover:text-white transition">Admin Portal</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">CONTENT</h3>
                    <ul class="space-y-2 text-zinc-400 text-xs font-medium">
                        <li><a href="/#catalog" class="hover:text-white transition">Catalog Items</a></li>
                        <li><a href="/about" class="hover:text-white transition">Company Info</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">LET'S TALK</h3>
                    <ul class="space-y-3">
                        <li>
                            <a href="mailto:malickielcelestine@gmail.com" class="hover:text-white transition text-xs font-medium block">
                                contact us
                            </a>
                        </li>
                        <li class="flex items-center gap-2 pt-1">
                            <a href="mailto:malickielcelestine@gmail.com" title="Email" class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-xs hover:border-zinc-500 hover:text-white transition">✉️</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 border-t border-zinc-900 pt-8 text-center text-[11px] text-zinc-600 space-y-2">
            <p>&copy; 2026 DOMINION Digital Store. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
