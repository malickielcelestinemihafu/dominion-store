<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Requests - DOMINION</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white font-sans min-h-screen flex flex-col selection:bg-white selection:text-black">

    <nav class="border-b border-zinc-800 bg-black/90 px-6 py-4 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black tracking-tighter uppercase hover:opacity-80 transition">
                DOMINION
            </a>
            <a href="/admin/items" class="text-xs text-zinc-400 hover:text-white transition font-medium">
                &larr; Back to Inventory
            </a>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-6 py-10 flex-grow w-full">
        <h1 class="text-4xl font-black tracking-tight uppercase mb-8">Acquisition Requests</h1>
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl overflow-hidden backdrop-blur-md">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-zinc-800 bg-zinc-900/90 text-zinc-400 text-xs uppercase tracking-wider">
                        <th class="p-4 font-bold">Date & Time</th>
                        <th class="p-4 font-bold">Product</th>
                        <th class="p-4 font-bold">Buyer</th>
                        <th class="p-4 font-bold">Buyer Contact</th>
                        <th class="p-4 font-bold">Qty</th>
                        <th class="p-4 font-bold">Status</th>
                        <th class="p-4 font-bold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/60 text-sm">
                    <% requests.forEach(req => { %>
                        <tr class="hover:bg-zinc-800/30 transition">
                            <td class="p-4 text-zinc-400 font-mono text-xs">
                                <%= req.createdAt ? new Date(req.createdAt).toLocaleString('en-GB') : 'N/A' %>
                            </td>
                            <td class="p-4 font-bold text-white"><%= req.itemTitle %></td>
                            <td class="p-4 text-zinc-300"><%= req.buyerName %></td>
                            <td class="p-4 text-zinc-400 font-mono text-xs">
                                <%= req.buyerEmail || req.buyerPhone || 'No Contact' %>
                            </td>
                            <td class="p-4 text-zinc-300"><%= req.quantity %></td>
                            <td class="p-4">
                                <% if (req.status === 'Attempted') { %>
                                    <span class="bg-yellow-500/10 text-yellow-500 border border-yellow-500/20 px-2.5 py-1 rounded-full text-xs font-bold">Attempted</span>
                                <% } else if (req.status === 'Completed') { %>
                                    <span class="bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 px-2.5 py-1 rounded-full text-xs font-bold">Completed</span>
                                <% } else { %>
                                    <span class="bg-zinc-800 text-zinc-400 border border-zinc-700 px-2.5 py-1 rounded-full text-xs font-bold">Pending</span>
                                <% } %>
                            </td>
                            <td class="p-4 text-right space-x-2">
                                <form action="/admin/requests/status/<%= req._id %>" method="POST" class="inline">
                                    <input type="hidden" name="status" value="<%= req.status === 'Attempted' ? 'Pending' : 'Attempted' %>">
                                    <button type="submit" class="bg-zinc-800 text-zinc-200 text-xs font-bold px-3 py-1.5 rounded-full hover:bg-zinc-700 transition">
                                        Mark as <%= req.status === 'Attempted' ? 'Pending' : 'Attempted' %>
                                    </button>
                                </form>

                                <% if (req.buyerEmail) { %>
                                    <a href="https://mail.google.com/mail/?view=cm&fs=1&to=<%= encodeURIComponent(req.buyerEmail) %>&su=DOMINION%20Order%20Inquiry%20-%20<%= encodeURIComponent(req.itemTitle) %>" 
                                       target="_blank"
                                       class="bg-white text-black text-xs font-bold px-3 py-1.5 rounded-full hover:bg-zinc-200 transition inline-block">
                                        Email
                                    </a>
                                <% } %>
                                <% if (req.buyerPhone) { %>
                                    <% 
                                        let cleanPhone = req.buyerPhone.replace(/[^0-9]/g, '');
                                        if (cleanPhone.startsWith('0')) {
                                            cleanPhone = '255' + cleanPhone.substring(1);
                                        }
                                    %>
                                    <a href="https://wa.me/<%= cleanPhone %>" 
                                       target="_blank"
                                       class="bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-full hover:bg-emerald-500 transition inline-block">
                                        WhatsApp
                                    </a>
                                <% } %>

                                <form action="/admin/requests/delete/<%= req._id %>" method="POST" class="inline" onsubmit="return confirm('Delete this request entry permanently?');">
                                    <button type="submit" class="bg-red-600/20 text-red-400 border border-red-600/30 text-xs font-bold px-3 py-1.5 rounded-full hover:bg-red-600 hover:text-white transition">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>

    <footer class="border-t border-zinc-900 p-6 text-center text-xs text-zinc-600">
        &copy; 2026 DOMINION. Order Requests.
    </footer>

</body>
</html>
