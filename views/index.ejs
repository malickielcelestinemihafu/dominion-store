<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DOMINION - Digital Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white font-sans min-h-screen flex flex-col selection:bg-white selection:text-black">

    <!-- Navigation -->
    <nav class="border-b border-zinc-800 bg-black/90 px-6 py-4 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black tracking-tighter uppercase hover:opacity-80 transition">
                DOMINION
            </a>
            <div class="flex items-center gap-6">
                <a href="/about" class="text-xs text-zinc-400 hover:text-white transition font-medium">About Us</a>
                <a href="/admin/login" class="text-xs text-zinc-400 hover:text-white transition font-medium">Admin Panel</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="border-b border-zinc-800/80 bg-zinc-950/50 py-16 px-6">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <span class="inline-block bg-zinc-800 text-zinc-300 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full border border-zinc-700">
                    Premium Digital Hub
                </span>
                <h1 class="text-5xl md:text-6xl font-black tracking-tight uppercase leading-none">
                    Elevating <span class="text-zinc-500">Value.</span><br>
                    Redefining <span class="text-white">Quality.</span>
                </h1>
                <p class="text-zinc-400 text-base md:text-lg max-w-xl font-normal leading-relaxed">
                    At <strong class="text-white">DOMINION</strong>, we don’t just offer goods—we deliver uncompromised value, precision performance, and elite reliability tailored for your digital lifestyle.
                </p>
                <div class="pt-2">
                    <a href="#catalog" class="inline-block bg-white text-black font-extrabold text-sm px-6 py-3.5 rounded-xl hover:bg-zinc-200 transition shadow-lg shadow-white/5">
                        Explore Catalog &darr;
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-4">
                    <div class="h-44 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=600&q=80" alt="Tech" class="w-full h-full object-cover opacity-80 hover:scale-105 transition duration-500">
                    </div>
                    <div class="h-32 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1550009158-9ebf69173e03?auto=format&fit=crop&w=600&q=80" alt="Hardware" class="w-full h-full object-cover opacity-80 hover:scale-105 transition duration-500">
                    </div>
                </div>
                <div class="space-y-4 pt-6">
                    <div class="h-32 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" alt="Audio" class="w-full h-full object-cover opacity-80 hover:scale-105 transition duration-500">
                    </div>
                    <div class="h-44 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80" alt="Gadgets" class="w-full h-full object-cover opacity-80 hover:scale-105 transition duration-500">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Search & Catalog Section -->
    <main id="catalog" class="max-w-7xl mx-auto px-6 py-12 flex-grow w-full">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
            <div>
                <h2 class="text-3xl font-black tracking-tight uppercase">Featured Products</h2>
                <p class="text-zinc-400 text-sm">Select an item to view specifications and request acquisition.</p>
            </div>
            
            <form action="/#catalog" method="GET" class="flex gap-3 max-w-md w-full">
                <input 
                    type="text" 
                    name="search" 
                    value="<%= searchQuery %>" 
                    placeholder="Search products..." 
                    class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-zinc-500 flex-grow"
                >
                <button type="submit" class="bg-zinc-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm hover:bg-zinc-700 transition">
                    Search
                </button>
                <% if (searchQuery) { %>
                    <a href="/#catalog" class="bg-zinc-900 border border-zinc-800 text-zinc-400 font-bold px-4 py-2.5 rounded-xl text-sm hover:text-white transition flex items-center">
                        Clear
                    </a>
                <% } %>
            </form>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% items.forEach(item => { %>
                <div class="bg-zinc-900/40 border border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-700 transition group flex flex-col">
                    <div class="aspect-video bg-zinc-950 overflow-hidden relative">
                        <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 flex flex-col flex-grow">
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="text-xl font-bold tracking-tight text-white"><%= item.title %></h3>
                            <span class="text-xs font-mono font-bold bg-white text-black px-2.5 py-1 rounded-full">
                                TSh <%= Number(item.price).toLocaleString() %>
                            </span>
                        </div>
                        <p class="text-zinc-400 text-sm line-clamp-2 mb-6 flex-grow"><%= item.description %></p>
                        <a href="/item/<%= item._id %>" class="block w-full text-center bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-sm py-3 rounded-xl transition">
                            View Details
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (items.length === 0) { %>
            <div class="text-center py-20 text-zinc-500">
                <p class="text-lg">No products found matching your search.</p>
            </div>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 bg-zinc-950 text-zinc-400 text-sm pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row justify-between items-start gap-12 mb-16">
            
            <div class="lg:w-1/3">
                <h2 class="text-5xl md:text-6xl font-black text-white tracking-tighter uppercase leading-none">
                    DOMINION
                </h2>
            </div>

            <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-3 gap-8 w-full">
                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">PAGES</h3>
                    <ul class="space-y-2 text-zinc-400 text-xs font-medium">
                        <li><a href="/about" class="hover:text-white transition underline">about us</a></li>
                        <li><a href="#catalog" class="hover:text-white transition">catalog</a></li>
                        <li><a href="/admin/login" class="hover:text-white transition">admin portal</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">CONTENT</h3>
                    <ul class="space-y-2 text-zinc-400 text-xs font-medium">
                        <li><a href="#catalog" class="hover:text-white transition">catalog items</a></li>
                        <li><a href="/about" class="hover:text-white transition">company profile</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-white font-black text-sm uppercase tracking-wider mb-4">LET'S TALK</h3>
                    <ul class="space-y-3">
                        <li>
                            <a href="mailto:malickielcelestine@gmail.com" class="hover:text-white transition text-xs font-medium block">
                                contact us
                            </a>
                        </li>
                        <li class="flex items-center gap-2 pt-1">
                            <a href="mailto:malickielcelestine@gmail.com" title="Email" class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-xs hover:border-zinc-500 hover:text-white transition">✉️</a>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        <div class="max-w-7xl mx-auto px-6 border-t border-zinc-900 pt-8 text-center text-[11px] text-zinc-600 space-y-2">
            <p>&copy; 2026 DOMINION Digital Store. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
