<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - DOMINION</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white font-sans min-h-screen flex flex-col selection:bg-white selection:text-black">

    <nav class="border-b border-zinc-800 bg-black/90 px-6 py-4 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black tracking-tighter uppercase hover:opacity-80 transition">
                DOMINION
            </a>
            <a href="/admin/items" class="text-xs text-zinc-400 hover:text-white transition font-medium">
                &larr; Back to Inventory
            </a>
        </div>
    </nav>

    <main class="max-w-2xl mx-auto px-6 py-12 flex-grow w-full">
        <div class="bg-zinc-900/60 border border-zinc-800 p-8 rounded-2xl backdrop-blur-md">
            <h1 class="text-3xl font-black tracking-tight uppercase mb-6">Edit Product</h1>
            <form action="/admin/edit/<%= item._id %>" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">Title</label>
                    <input type="text" name="title" value="<%= item.title %>" required class="w-full bg-black border border-zinc-800 text-white p-3 rounded-xl text-sm focus:outline-none focus:border-white transition">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">Price (TSh)</label>
                    <input type="number" step="0.01" name="price" value="<%= item.price %>" required class="w-full bg-black border border-zinc-800 text-white p-3 rounded-xl text-sm focus:outline-none focus:border-white transition">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">Image URL</label>
                    <input type="text" name="imageUrl" value="<%= item.imageUrl %>" required class="w-full bg-black border border-zinc-800 text-white p-3 rounded-xl text-sm focus:outline-none focus:border-white transition">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">Description</label>
                    <textarea name="description" rows="3" required class="w-full bg-black border border-zinc-800 text-white p-3 rounded-xl text-sm focus:outline-none focus:border-white transition"><%= item.description %></textarea>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2">Specifications</label>
                    <textarea name="specs" rows="2" class="w-full bg-black border border-zinc-800 text-white p-3 rounded-xl text-sm focus:outline-none focus:border-white transition"><%= item.specs %></textarea>
                </div>
                <button type="submit" class="w-full bg-white text-black font-extrabold py-3.5 rounded-full hover:bg-zinc-200 transition uppercase tracking-wider text-xs">
                    Update Product
                </button>
            </form>
        </div>
    </main>

    <footer class="border-t border-zinc-900 p-6 text-center text-xs text-zinc-600">
        &copy; 2026 DOMINION. Inventory Control.
    </footer>

</body>
</html>
